{
  "name": "cuppet-monorepo",
  "version": "0.2.0-alpha.1",
  "private": true,
  "description": "Cuppet public alpha: OpenCode-backed terminal coding agent with native TST memory",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/cli",
    "packages/opencode-plugin"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present && cargo build --workspace --locked",
    "build:ts": "npm run build --workspaces --if-present",
    "build:rust": "cargo build --workspace --locked",
    "eval:ab": "node --import tsx scripts/ab-eval.ts",
    "eval:ab:tic-tac-toe": "node --import tsx scripts/ab-tictactoe.ts",
    "game:test": "node --import tsx games/tic-tac-toe/test/game.test.ts",
    "game:typecheck": "tsc --noEmit --project games/tic-tac-toe/tsconfig.json",
    "game:play": "node --import tsx games/tic-tac-toe/src/cli.ts",
    "check": "npm run typecheck --workspaces --if-present && cargo check --workspace --locked",
    "dev": "npm run dev --workspace=cuppet",
    "install:global": "node scripts/install-global.mjs",
    "lint": "cargo clippy --workspace --all-targets --locked -- -D warnings",
    "test": "npm run test --workspaces --if-present && cargo test --workspace --locked",
    "test:ts": "npm run test --workspaces --if-present",
    "test:rust": "cargo test --workspace --locked",
    "fmt:check": "cargo fmt --all -- --check",
    "clean": "npm run clean --workspaces --if-present && cargo clean"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "@types/react": "18.3.20",
    "tsx": "4.19.4",
    "typescript": "5.8.3"
  }
}
