@@ -0,0 +1,188 @@
+package actionlint
+
+import (
+	"fmt"
+	"regexp"
+	"strconv"
+	"strings"
+)
+
+var (
+	actionPinningMajorMinor = regexp.MustCompile(`^v(?:0|[1-9][0-9]*)\.(?:0|[1-9][0-9]*)$`)
+	actionPinningSemver     = regexp.MustCompile(`^v(?:0|[1-9][0-9]*)\.(?:0|[1-9][0-9]*)\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\+[0-9A-Za-z-]+(?:\.[0-9A-Za-z-]+)*)?$`)
+	actionPinningCommitSHA  = regexp.MustCompile(`^[0-9a-f]{40}$`)
+)
+
+// RuleActionPinning checks that remote actions and reusable workflows use pinned refs.
+type RuleActionPinning struct {
+	RuleBase
+	workflowPath string
+	override     ActionPinningLevel
+}
+
+// NewRuleActionPinning creates a rule for the workflow at the given path.
+func NewRuleActionPinning(workflowPath string, override ActionPinningLevel) *RuleActionPinning {
+	return &RuleActionPinning{
+		RuleBase:     NewRuleBase("action-pinning", "Checks that action and reusable workflow refs are pinned"),
+		workflowPath: workflowPath,
+		override:     override,
+	}
+}
+
+// VisitStep checks a step-level action reference.
+func (rule *RuleActionPinning) VisitStep(n *Step) error {
+	if action, ok := n.Exec.(*ExecAction); ok && action.Uses != nil {
+		rule.check(action.Uses, "action")
+	}
+	return nil
+}
+
+// VisitJobPre checks a job-level reusable workflow reference.
+func (rule *RuleActionPinning) VisitJobPre(n *Job) error {
+	if n.WorkflowCall != nil && n.WorkflowCall.Uses != nil {
+		rule.check(n.WorkflowCall.Uses, "reusable workflow")
+	}
+	return nil
+}
+
+func (rule *RuleActionPinning) check(uses *String, kind string) {
+	policy := rule.Config().actionPinningPolicy(rule.workflowPath, rule.override)
+	if policy == nil || uses.Value == "" {
+		return
+	}
+
+	spec := uses.Value
+	if strings.HasPrefix(spec, "./") || strings.HasPrefix(spec, "docker://") {
+		return
+	}
+
+	name, ref := spec, ""
+	if at := actionPinningRefSeparator(spec); at >= 0 {
+		name, ref = spec[:at], spec[at+1:]
+	}
+	if ContainsExpression(name) {
+		return
+	}
+	if policy.allows(name) {
+		return
+	}
+	if ContainsExpression(ref) {
+		rule.Errorf(uses.Pos, "%s reference %q has a dynamic expression as its ref; the ref is a dynamic expression that cannot be verified for pinning", kind, spec)
+		return
+	}
+	if actionPinningRefSatisfies(ref, policy.level) {
+		return
+	}
+
+	expected := map[ActionPinningLevel]string{
+		ActionPinningLevelMajorMinor: `vMAJOR.MINOR`,
+		ActionPinningLevelSemver:     `vMAJOR.MINOR.PATCH (prerelease versions are allowed)`,
+		ActionPinningLevelCommitSHA:  `a full 40-character lowercase hexadecimal commit SHA`,
+	}[policy.level]
+	message := fmt.Sprintf("%s reference %q is not pinned at the %q level; expected %s", kind, spec, policy.level, expected)
+	if kind == "action" {
+		if known := latestKnownActionSpec(name); known != "" {
+			if policy.level == ActionPinningLevelCommitSHA {
+				message += fmt.Sprintf("; resolve the known version %q to its full commit SHA", known)
+			} else {
+				message += fmt.Sprintf("; choose a %s release corresponding to the known version %q", expected, known)
+			}
+		}
+	}
+	rule.Error(uses.Pos, message)
+}
+
+func actionPinningRefSeparator(spec string) int {
+	for i := 0; i < len(spec); i++ {
+		if strings.HasPrefix(spec[i:], "${{") {
+			if end := strings.Index(spec[i+3:], "}}"); end >= 0 {
+				i += end + 4
+				continue
+			}
+		}
+		if spec[i] == '@' {
+			return i
+		}
+	}
+	return -1
+}
+
+func (p *actionPinningPolicy) allows(name string) bool {
+	parts := strings.Split(name, "/")
+	if len(parts) < 2 {
+		return false
+	}
+	owner := strings.ToLower(parts[0])
+	action := owner + "/" + strings.ToLower(parts[1])
+	_, ownerDenied := p.deniedOwners[owner]
+	_, actionDenied := p.deniedActions[action]
+	if ownerDenied || actionDenied {
+		return false
+	}
+	_, ownerAllowed := p.allowedOwners[owner]
+	_, actionAllowed := p.allowedActions[action]
+	return ownerAllowed || actionAllowed
+}
+
+func actionPinningRefSatisfies(ref string, level ActionPinningLevel) bool {
+	if actionPinningCommitSHA.MatchString(ref) {
+		return true
+	}
+	if level == ActionPinningLevelCommitSHA {
+		return false
+	}
+	if actionPinningSemver.MatchString(ref) {
+		return true
+	}
+	return level == ActionPinningLevelMajorMinor && actionPinningMajorMinor.MatchString(ref)
+}
+
+func latestKnownActionSpec(name string) string {
+	want := strings.ToLower(name)
+	bestSpec, bestRef := "", ""
+	for spec := range PopularActions {
+		at := strings.LastIndexByte(spec, '@')
+		if at < 0 || strings.ToLower(spec[:at]) != want {
+			continue
+		}
+		ref := spec[at+1:]
+		if bestSpec == "" || compareKnownActionRefs(ref, bestRef) > 0 {
+			bestSpec, bestRef = spec, ref
+		}
+	}
+	return bestSpec
+}
+
+func compareKnownActionRefs(left, right string) int {
+	parse := func(ref string) ([3]int, bool) {
+		var version [3]int
+		if len(ref) < 2 || ref[0] != 'v' {
+			return version, false
+		}
+		parts := strings.SplitN(ref[1:], "-", 2)
+		for i, part := range strings.Split(parts[0], ".") {
+			if i == len(version) {
+				break
+			}
+			n, err := strconv.Atoi(part)
+			if err != nil {
+				return version, false
+			}
+			version[i] = n
+		}
+		return version, true
+	}
+	lv, lok := parse(left)
+	rv, rok := parse(right)
+	if lok && rok {
+		for i := range lv {
+			if lv[i] < rv[i] {
+				return -1
+			}
+			if lv[i] > rv[i] {
+				return 1
+			}
+		}
+	}
+	return strings.Compare(left, right)
+}
