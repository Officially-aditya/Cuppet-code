diff --git a/rule_action_pinning.go b/rule_action_pinning.go
new file mode 100644
index 0000000..c63c15a
--- /dev/null
+++ b/rule_action_pinning.go
@@ -0,0 +1,136 @@
+package actionlint
+
+import (
+	"regexp"
+	"strings"
+)
+
+var pinPatterns = [...]string{`^v[0-9]+\.[0-9]+$`, `^v[0-9]+\.[0-9]+\.[0-9]+(?:-[0-9A-Za-z.-]+)?$`, `^[0-9a-f]{40}$`}
+
+type RuleActionPinning struct {
+	RuleBase
+	path, cliLevel string
+}
+
+func NewRuleActionPinning(path, cliLevel string) *RuleActionPinning {
+	return &RuleActionPinning{RuleBase: NewRuleBase("action-pinning", "Checks that action and reusable workflow references are pinned"), path: path, cliLevel: cliLevel}
+}
+
+func (r *RuleActionPinning) setting() (*ActionPinningConfig, bool) {
+	cfg := r.Config()
+	var base *ActionPinningConfig
+	if cfg != nil {
+		base = cfg.ActionPinning
+	}
+	paths := []PathConfig{}
+	if cfg != nil {
+		paths = cfg.PathConfigs(r.path)
+	}
+	enabled := base != nil
+	level := "semver"
+	if base != nil {
+		if base.Level != "" {
+			level = base.Level
+		}
+	}
+	merged := &ActionPinningConfig{Level: level}
+	merge := func(c *ActionPinningConfig) {
+		if c == nil {
+			return
+		}
+		enabled = true
+		if c.Level != "" {
+			merged.Level = c.Level
+		}
+		merged.AllowedOwners = append(merged.AllowedOwners, c.AllowedOwners...)
+		merged.AllowedActions = append(merged.AllowedActions, c.AllowedActions...)
+		merged.DeniedOwners = append(merged.DeniedOwners, c.DeniedOwners...)
+		merged.DeniedActions = append(merged.DeniedActions, c.DeniedActions...)
+	}
+	merge(base)
+	for _, p := range paths {
+		merge(p.ActionPinning)
+	}
+	if r.cliLevel != "" {
+		enabled = true
+		merged.Level = r.cliLevel
+	}
+	return merged, enabled
+}
+
+func (r *RuleActionPinning) VisitStep(n *Step) error {
+	e, ok := n.Exec.(*ExecAction)
+	if ok && e.Uses != nil {
+		r.check(e.Uses)
+	}
+	return nil
+}
+func (r *RuleActionPinning) VisitJobPre(n *Job) error {
+	if n.WorkflowCall != nil && n.WorkflowCall.Uses != nil {
+		r.check(n.WorkflowCall.Uses)
+	}
+	return nil
+}
+
+func (r *RuleActionPinning) check(s *String) {
+	cfg, enabled := r.setting()
+	if !enabled {
+		return
+	}
+	spec := s.Value
+	if strings.HasPrefix(spec, "./") || strings.HasPrefix(spec, "docker://") {
+		return
+	}
+	at := strings.LastIndex(spec, "@")
+	if at < 0 {
+		r.Errorf(s.Pos, "reference %q is not pinned: version ref is missing", spec)
+		return
+	}
+	name, ref := spec[:at], spec[at+1:]
+	if ContainsExpression(name) {
+		return
+	}
+	if ContainsExpression(ref) {
+		r.Errorf(s.Pos, "reference %q is not pinned: ref is a dynamic expression that cannot be verified for pinning", spec)
+		return
+	}
+	parts := strings.Split(name, "/")
+	if len(parts) < 2 {
+		return
+	}
+	owner, repo := strings.ToLower(parts[0]), strings.ToLower(parts[1])
+	allowed := false
+	denied := false
+	for _, x := range cfg.AllowedOwners {
+		allowed = allowed || strings.EqualFold(x, owner)
+	}
+	for _, x := range cfg.DeniedOwners {
+		denied = denied || strings.EqualFold(x, owner)
+	}
+	for _, x := range cfg.AllowedActions {
+		allowed = allowed || strings.EqualFold(x, owner+"/"+repo)
+	}
+	for _, x := range cfg.DeniedActions {
+		denied = denied || strings.EqualFold(x, owner+"/"+repo)
+	}
+	if allowed && !denied {
+		return
+	}
+	level := map[string]int{"major-minor": 0, "semver": 1, "commit-sha": 2}[cfg.Level]
+	if !regexp.MustCompile(pinPatterns[level]).MatchString(ref) {
+		msg := "%s %q is not pinned to %s"
+		args := []interface{}{func() string {
+			if strings.Contains(name, "/.github/workflows/") {
+				return "reusable workflow"
+			}
+			return "action"
+		}(), spec, cfg.Level}
+		for known := range PopularActions {
+			if strings.HasPrefix(known, name+"@") {
+				msg += "; known version is " + known
+				break
+			}
+		}
+		r.Errorf(s.Pos, msg, args...)
+	}
+}
