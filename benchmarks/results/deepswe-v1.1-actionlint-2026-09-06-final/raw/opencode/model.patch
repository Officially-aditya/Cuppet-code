+func validateActionPinning(c *ActionPinningConfig) error {
+	if c == nil {
+		return nil
+	}
+	if c.Level != "" && c.Level != "major-minor" && c.Level != "semver" && c.Level != "commit-sha" {
+		return fmt.Errorf("invalid action-pinning level %q", c.Level)
+	}
+	for _, owner := range append(append([]string{}, c.AllowedOwners...), c.DeniedOwners...) {
+		if strings.Contains(owner, "/") {
+			return fmt.Errorf("invalid action-pinning owner %q", owner)
+		}
+	}
+	for _, action := range append(append([]string{}, c.AllowedActions...), c.DeniedActions...) {
+		p := strings.Split(action, "/")
+		if len(p) != 2 || p[0] == "" || p[1] == "" {
+			return fmt.Errorf("invalid action-pinning action %q", action)
+		}
+	}
+	return nil
