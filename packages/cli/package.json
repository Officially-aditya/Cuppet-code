{
  "name": "cuppet",
  "version": "0.2.0-alpha.1",
  "description": "OpenCode-backed terminal coding agent with native tiered memory",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "cuppet": "dist/cli.js",
    "cupet": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "dev": "tsx src/cli.tsx",
    "prepack": "node ../../scripts/prepare-cli-package.mjs && npm run build",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.13.0",
    "@opencode-ai/sdk": "1.18.4",
    "google-auth-library": "^10.9.0",
    "ink": "5.2.1",
    "ink-select-input": "6.2.0",
    "ink-text-input": "6.0.0",
    "react": "18.3.1",
    "zod": "3.25.76"
  },
  "optionalDependencies": {
    "@cuppet/runtime-darwin-arm64": "0.2.0-alpha.1",
    "@cuppet/runtime-darwin-x64": "0.2.0-alpha.1",
    "@cuppet/runtime-linux-arm64-gnu": "0.2.0-alpha.1",
    "@cuppet/runtime-linux-x64-gnu": "0.2.0-alpha.1"
  },
  "devDependencies": {
    "tsup": "8.4.0"
  }
}
