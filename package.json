{
  "name": "cuppet-monorepo",
  "version": "0.2.0-alpha.1",
  "private": true,
  "description": "Cuppet public alpha: modified OpenCode TUI derivative with native TST memory",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/cli",
    "packages/opencode-plugin"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present && cargo build --workspace --locked",
    "build:ts": "npm run build --workspaces --if-present",
    "build:opencode": "node scripts/build-opencode.mjs",
    "package:platform": "node scripts/package-platform.mjs",
    "build:rust": "cargo build --workspace --locked",
    "eval:ab": "node --import tsx scripts/ab-eval.ts",
    "eval:ab:persistent": "CUPPET_AB_PERSISTENT_GRAPH=1 node --import tsx scripts/ab-eval.ts",
    "eval:native:tst": "node --import tsx scripts/native-tst-benchmark.ts",
    "eval:background": "node --import tsx scripts/continuous-background-benchmark.ts",
    "eval:ab:tic-tac-toe": "node --import tsx scripts/ab-tictactoe.ts",
    "eval:ab:weather-codex-cuppet": "node --import tsx scripts/ab-weather-codex-cuppet.ts",
    "eval:ab:weather-opencode-cuppet": "CUPPET_WEATHER_ARMS=opencode,cuppet CUPPET_WEATHER_LABEL=opencode-cuppet node --import tsx scripts/ab-weather-codex-cuppet.ts",
    "eval:ab:opencode-cuppet-10-tasks": "node --import tsx scripts/ab-opencode-cuppet-10-tasks.ts",
    "eval:ab:hard": "node --import tsx scripts/ab-opencode-cuppet-hard-tasks.ts",
    "eval:ab:marathon": "node --import tsx scripts/ab-opencode-cuppet-marathon.ts",
    "game:test": "node --import tsx games/tic-tac-toe/test/game.test.ts",
    "game:typecheck": "tsc --noEmit --project games/tic-tac-toe/tsconfig.json",
    "game:play": "node --import tsx games/tic-tac-toe/src/cli.ts",
    "task-tracker:test": "node --import tsx games/task-tracker/test/task-tracker.test.ts",
    "task-tracker:typecheck": "tsc --noEmit --project games/task-tracker/tsconfig.json",
    "task-tracker:run": "node --import tsx games/task-tracker/src/cli/main.ts",
    "eval:ab:task-tracker": "node --import tsx scripts/ab-task-tracker.ts",
    "eval:ab:task-tracker-prompt": "node --import tsx scripts/ab-task-tracker-prompt.ts",
    "eval:ab:task-tracker-graph-first": "node --import tsx scripts/ab-task-tracker-graph-first.ts",
    "eval:ab:task-tracker-graph-only": "node --import tsx scripts/ab-task-tracker-graph-only.ts",
    "eval:ab:task-tracker-graph-native": "node --import tsx scripts/ab-task-tracker-graph-native.ts",
    "eval:ab:stm-compaction": "node --import tsx scripts/ab-stm-compaction.ts",
    "check": "npm run typecheck --workspaces --if-present && cargo check --workspace --locked",
    "dev": "npm run dev --workspace=cuppet",
    "install:global": "node scripts/install-global.mjs",
    "lint": "cargo clippy --workspace --all-targets --locked -- -D warnings",
    "test": "npm run test --workspaces --if-present && cargo test --workspace --locked",
    "test:ts": "npm run test --workspaces --if-present",
    "test:rust": "cargo test --workspace --locked",
    "fmt:check": "cargo fmt --all -- --check",
    "clean": "npm run clean --workspaces --if-present && cargo clean"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "tsx": "4.19.4",
    "typescript": "5.8.3"
  },
  "dependencies": {
    "opencode-ai": "^1.18.21"
  }
}
