+/** Cuppet's user-facing strings for the OpenCode TUI derivative. */
+export const CUPPET_PRODUCT = "Cuppet"
+export const CUPPET_WORDMARK = "CUPPET"
+export const CUPPET_TERMINAL_TITLE = "Cuppet"
+export const CUPPET_HELP_PREFIX = "Cuppet help"
+export const CUPPET_STATUS_PREFIX = "Cuppet status"
+export const CUPPET_CRASH_PREFIX = "Cuppet crashed"
+export const CUPPET_RESUME_COMMANDS = ["cuppet --continue", "cuppet --session <id>"] as const
+
+export function productText(value: string): string {
+  return value.replace(/\bOpenCode\b/g, CUPPET_PRODUCT)
+}
