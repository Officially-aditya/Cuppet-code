+func actionPinningLevelStrictness(level ActionPinningLevel) int {
+	switch level {
+	case ActionPinningLevelMajorMinor:
+		return 1
+	case ActionPinningLevelSemver, "":
+		return 2
+	case ActionPinningLevelCommitSHA:
+		return 3
+	default:
+		return 0
+	}
+}
+
+func validateActionPinningConfig(c *ActionPinningConfig, where string) error {
+	if c == nil {
+		return nil
+	}
+	if actionPinningLevelStrictness(c.Level) == 0 {
+		return fmt.Errorf("invalid action pinning level %q in %s; expected one of %q, %q, or %q", c.Level, where, ActionPinningLevelMajorMinor, ActionPinningLevelSemver, ActionPinningLevelCommitSHA)
+	}
+	for _, list := range []struct {
+		name   string
+		values []string
+	}{
+		{"allowed-owners", c.AllowedOwners},
+		{"denied-owners", c.DeniedOwners},
+	} {
+		for _, owner := range list.values {
+			if owner == "" || strings.Contains(owner, "/") || strings.ContainsAny(owner, "@ \t\r\n") {
+				return fmt.Errorf("invalid owner %q in %q in %s; expected a non-empty owner without slashes, whitespace, or @", owner, list.name, where)
+			}
+		}
+	}
+	for _, list := range []struct {
+		name   string
+		values []string
+	}{
+		{"allowed-actions", c.AllowedActions},
+		{"denied-actions", c.DeniedActions},
+	} {
+		for _, action := range list.values {
+			parts := strings.Split(action, "/")
+			if len(parts) != 2 || parts[0] == "" || parts[1] == "" || strings.ContainsAny(action, "@ \t\r\n") {
+				return fmt.Errorf("invalid action %q in %q in %s; expected owner/repo", action, list.name, where)
+			}
+		}
+	}
+	return nil
+}
+
+func mergeActionPinningLists(dst *ActionPinningConfig, src *ActionPinningConfig) {
+	appendUnique := func(dst []string, src []string) []string {
+		seen := make(map[string]struct{}, len(dst)+len(src))
+		for _, value := range dst {
+			seen[strings.ToLower(value)] = struct{}{}
+		}
+		for _, value := range src {
+			key := strings.ToLower(value)
+			if _, ok := seen[key]; ok {
+				continue
+			}
+			seen[key] = struct{}{}
+			dst = append(dst, value)
+		}
+		return dst
+	}
+	dst.AllowedOwners = appendUnique(dst.AllowedOwners, src.AllowedOwners)
+	dst.AllowedActions = appendUnique(dst.AllowedActions, src.AllowedActions)
+	dst.DeniedOwners = appendUnique(dst.DeniedOwners, src.DeniedOwners)
+	dst.DeniedActions = appendUnique(dst.DeniedActions, src.DeniedActions)
+}
+
+// ActionPinningForPath resolves action pinning configuration for a workflow path. The CLI level
+// override enables the rule and takes precedence over configured levels.
+func (cfg *Config) ActionPinningForPath(path string, cliLevel ActionPinningLevel) *ActionPinningConfig {
+	var ret *ActionPinningConfig
+	if cfg != nil && cfg.ActionPinning != nil {
+		ret = &ActionPinningConfig{Level: cfg.ActionPinning.Level}
+		mergeActionPinningLists(ret, cfg.ActionPinning)
+	}
+
+	path = filepath.ToSlash(path)
+	pathLevel := ActionPinningLevel("")
+	hasPathLevel := false
+	if cfg != nil {
+		for pattern, pc := range cfg.Paths {
+			if pc.ActionPinning == nil || !doublestar.MatchUnvalidated(pattern, path) {
+				continue
+			}
+			if ret == nil {
+				ret = &ActionPinningConfig{}
+			}
+			mergeActionPinningLists(ret, pc.ActionPinning)
+			level := pc.ActionPinning.Level
+			if level == "" {
+				level = ActionPinningLevelSemver
+			}
+			if !hasPathLevel || actionPinningLevelStrictness(level) > actionPinningLevelStrictness(pathLevel) {
+				pathLevel = level
+				hasPathLevel = true
+			}
+		}
+	}
+	if ret == nil && cliLevel == "" {
+		return nil
+	}
+	if ret == nil {
+		ret = &ActionPinningConfig{}
+	}
+	if hasPathLevel {
+		ret.Level = pathLevel
+	} else if ret.Level == "" {
+		ret.Level = ActionPinningLevelSemver
+	}
+	if cliLevel != "" {
+		ret.Level = cliLevel
+	}
+	return ret
+}
