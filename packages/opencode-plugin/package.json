{
  "name": "@cuppet-code/opencode-plugin",
  "version": "0.2.0-alpha.1",
  "private": true,
  "description": "Cuppet server and native-TUI plugins for the bundled OpenCode derivative",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./server": "./dist/server.js",
    "./tui": "./dist/tui.js"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "3.25.76"
  },
  "devDependencies": {
    "tsup": "8.4.0"
  }
}
