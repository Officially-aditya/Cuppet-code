+func TestConfigActionPinningEnablementAndDefaults(t *testing.T) {
+	tests := []struct {
+		name    string
+		input   string
+		path    string
+		wantNil bool
+		level   ActionPinningLevel
+	}{
+		{"absent", "", "workflow.yml", true, ""},
+		{"null", "action-pinning: null", "workflow.yml", true, ""},
+		{"empty", "action-pinning: {}", "workflow.yml", false, ActionPinningLevelSemver},
+		{"global level", "action-pinning:\n  level: major-minor", "workflow.yml", false, ActionPinningLevelMajorMinor},
+		{"path enables", "paths:\n  '*.yml':\n    action-pinning: {}", "workflow.yml", false, ActionPinningLevelSemver},
+		{"path does not match", "paths:\n  '*.yaml':\n    action-pinning: {}", "workflow.yml", true, ""},
+		{"path default overrides global", "action-pinning:\n  level: commit-sha\npaths:\n  '*.yml':\n    action-pinning: {}", "workflow.yml", false, ActionPinningLevelSemver},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			cfg, err := ParseConfig([]byte(tc.input))
+			if err != nil {
+				t.Fatal(err)
+			}
+			pinning := cfg.ActionPinningForPath(tc.path, "")
+			if (pinning == nil) != tc.wantNil {
+				t.Fatalf("unexpected resolved config: %#v", pinning)
+			}
+			if pinning != nil && pinning.Level != tc.level {
