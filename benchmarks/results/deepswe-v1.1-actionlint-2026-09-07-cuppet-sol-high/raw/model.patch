diff --git a/rule_action_pinning.go b/rule_action_pinning.go
new file mode 100644
index 0000000..1016bc4
--- /dev/null
+++ b/rule_action_pinning.go
@@ -0,0 +1,183 @@
+package actionlint
+
+import (
+	"fmt"
+	"regexp"
+	"strconv"
+	"strings"
+)
+
+var (
+	actionPinningMajorMinorPattern = regexp.MustCompile(`^v(?:0|[1-9][0-9]*)\.(?:0|[1-9][0-9]*)$`)
+	actionPinningSemverPattern     = regexp.MustCompile(`^v(?:0|[1-9][0-9]*)\.(?:0|[1-9][0-9]*)\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\+[0-9A-Za-z-]+(?:\.[0-9A-Za-z-]+)*)?$`)
+	actionPinningCommitSHAPattern  = regexp.MustCompile(`^[0-9a-f]{40}$`)
+	knownActionMajorPattern        = regexp.MustCompile(`^v([0-9]+)`)
+)
+
+// RuleActionPinning checks that remote action and reusable workflow references use pinned refs.
+type RuleActionPinning struct {
+	RuleBase
+	level          ActionPinningLevel
+	allowedOwners  map[string]struct{}
+	allowedActions map[string]struct{}
+	deniedOwners   map[string]struct{}
+	deniedActions  map[string]struct{}
+}
+
+// NewRuleActionPinning creates a new action pinning rule from resolved configuration.
+func NewRuleActionPinning(config *ActionPinningConfig) *RuleActionPinning {
+	if config == nil {
+		config = &ActionPinningConfig{}
+	}
+	level := config.Level
+	if level == "" {
+		level = ActionPinningLevelSemver
+	}
+	rule := &RuleActionPinning{
+		RuleBase: RuleBase{
+			name: "action-pinning",
+			desc: "Checks that action and reusable workflow references are pinned to immutable or versioned refs",
+		},
+		level:          level,
+		allowedOwners:  map[string]struct{}{},
+		allowedActions: map[string]struct{}{},
+		deniedOwners:   map[string]struct{}{},
+		deniedActions:  map[string]struct{}{},
+	}
+	for _, owner := range config.AllowedOwners {
+		rule.allowedOwners[strings.ToLower(owner)] = struct{}{}
+	}
+	for _, action := range config.AllowedActions {
+		rule.allowedActions[strings.ToLower(action)] = struct{}{}
+	}
+	for _, owner := range config.DeniedOwners {
+		rule.deniedOwners[strings.ToLower(owner)] = struct{}{}
+	}
+	for _, action := range config.DeniedActions {
+		rule.deniedActions[strings.ToLower(action)] = struct{}{}
+	}
+	return rule
+}
+
+// VisitStep checks an action reference in a step.
+func (rule *RuleActionPinning) VisitStep(n *Step) error {
+	exec, ok := n.Exec.(*ExecAction)
+	if ok && exec.Uses != nil {
+		rule.checkUses(exec.Uses, "step action")
+	}
+	return nil
+}
+
+// VisitJobPre checks a reusable workflow reference in a job.
+func (rule *RuleActionPinning) VisitJobPre(n *Job) error {
+	if n.WorkflowCall != nil && n.WorkflowCall.Uses != nil {
+		rule.checkUses(n.WorkflowCall.Uses, "reusable workflow")
+	}
+	return nil
+}
+
+func (rule *RuleActionPinning) checkUses(uses *String, kind string) {
+	spec := uses.Value
+	if strings.HasPrefix(spec, "./") || strings.HasPrefix(spec, "docker://") {
+		return
+	}
+
+	at, dynamicAction := actionRefSeparator(spec)
+	if dynamicAction {
+		return
+	}
+	if at < 0 {
+		return
+	}
+	action, ref := spec[:at], spec[at+1:]
+	if action == "" || ref == "" {
+		return
+	}
+
+	parts := strings.Split(action, "/")
+	if len(parts) < 2 || parts[0] == "" || parts[1] == "" {
+		return
+	}
+	owner := strings.ToLower(parts[0])
+	repo := strings.ToLower(parts[0] + "/" + parts[1])
+	_, deniedOwner := rule.deniedOwners[owner]
+	_, deniedAction := rule.deniedActions[repo]
+	if !deniedOwner && !deniedAction {
+		_, allowedOwner := rule.allowedOwners[owner]
+		_, allowedAction := rule.allowedActions[repo]
+		if allowedOwner || allowedAction {
+			return
+		}
+	}
+	if ContainsExpression(ref) {
+		rule.Errorf(uses.Pos, "%s reference %q has a dynamic expression in its ref that cannot be verified for pinning", kind, spec)
+		return
+	}
+
+	if rule.refSatisfiesLevel(ref) {
+		return
+	}
+
+	message := fmt.Sprintf("%s reference %q is not pinned at the required %q level", kind, spec, rule.level)
+	if known := knownPopularActionSpec(action, ref); known != "" {
+		message += fmt.Sprintf("; pin known action version %q to a ref satisfying this level", known)
+	}
+	rule.Error(uses.Pos, message)
+}
+
+func actionRefSeparator(spec string) (int, bool) {
+	dynamicAction := false
+	for i := 0; i < len(spec); i++ {
+		if strings.HasPrefix(spec[i:], "${{") {
+			dynamicAction = true
+			end := strings.Index(spec[i+3:], "}}")
+			if end < 0 {
+				return -1, true
+			}
+			i += end + 4
+			continue
+		}
+		if spec[i] == '@' {
+			return i, dynamicAction
+		}
+	}
+	return -1, dynamicAction
+}
+
+func (rule *RuleActionPinning) refSatisfiesLevel(ref string) bool {
+	if actionPinningCommitSHAPattern.MatchString(ref) {
+		return true
+	}
+	if rule.level == ActionPinningLevelCommitSHA {
+		return false
+	}
+	if actionPinningSemverPattern.MatchString(ref) {
+		return true
+	}
+	return rule.level == ActionPinningLevelMajorMinor && actionPinningMajorMinorPattern.MatchString(ref)
+}
+
+func knownPopularActionSpec(action string, ref string) string {
+	spec := action + "@" + ref
+	known := ""
+	knownMajor := int64(-1)
+	for candidate := range PopularActions {
+		if strings.EqualFold(candidate, spec) {
+			return candidate
+		}
+		at := strings.LastIndexByte(candidate, '@')
+		if at < 0 || !strings.EqualFold(candidate[:at], action) {
+			continue
+		}
+		candidateRef := candidate[at+1:]
+		major := int64(-1)
+		if match := knownActionMajorPattern.FindStringSubmatch(candidateRef); match != nil {
+			major, _ = strconv.ParseInt(match[1], 10, 64)
+		}
+		if major > knownMajor || major == knownMajor && candidate > known {
+			known = candidate
+			knownMajor = major
+		}
+	}
+	return known
+}
