diff --git a/rule_action_pinning.go b/rule_action_pinning.go
new file mode 100644
index 0000000..8901770
--- /dev/null
+++ b/rule_action_pinning.go
@@ -0,0 +1,148 @@
+package actionlint
+
+import (
+	"fmt"
+	"regexp"
+	"sort"
+	"strings"
+)
+
+// RuleActionPinning checks that remote actions and reusable workflows use immutable enough refs.
+type RuleActionPinning struct {
+	RuleBase
+	path, cliLevel string
+}
+
+func NewRuleActionPinning(path, cliLevel string) *RuleActionPinning {
+	return &RuleActionPinning{RuleBase: NewRuleBase("action-pinning", "Checks that action and reusable workflow references are pinned"), path: path, cliLevel: cliLevel}
+}
+
+func (r *RuleActionPinning) policy() (*ActionPinningConfig, bool) {
+	var base *ActionPinningConfig
+	if r.Config() != nil {
+		base = r.Config().ActionPinning
+	}
+	cs := r.Config().PathConfigs(r.path)
+	enabled := base != nil
+	level := "semver"
+	if base != nil && base.Level != "" {
+		level = base.Level
+	}
+	merged := &ActionPinningConfig{Level: level}
+	merge := func(c *ActionPinningConfig) {
+		if c == nil {
+			return
+		}
+		enabled = true
+		if c.Level != "" {
+			merged.Level = c.Level
+		}
+		merged.AllowedOwners = append(merged.AllowedOwners, c.AllowedOwners...)
+		merged.AllowedActions = append(merged.AllowedActions, c.AllowedActions...)
+		merged.DeniedOwners = append(merged.DeniedOwners, c.DeniedOwners...)
+		merged.DeniedActions = append(merged.DeniedActions, c.DeniedActions...)
+	}
+	if base != nil {
+		merge(base)
+	}
+	for _, c := range cs {
+		merge(c.ActionPinning)
+	}
+	if r.cliLevel != "" {
+		enabled = true
+		merged.Level = r.cliLevel
+	}
+	if !enabled {
+		return nil, false
+	}
+	return merged, true
+}
+
+func (r *RuleActionPinning) check(s *String, workflow bool) {
+	p, ok := r.policy()
+	if !ok || s == nil {
+		return
+	}
+	v := s.Value
+	if strings.HasPrefix(v, "./") || strings.HasPrefix(v, "docker://") {
+		return
+	}
+	i := strings.IndexByte(v, '@')
+	if i < 0 {
+		return
+	}
+	name, ref := v[:i], v[i+1:]
+	if ContainsExpression(name) {
+		return
+	}
+	parts := strings.Split(name, "/")
+	if len(parts) < 2 {
+		return
+	}
+	owner, action := parts[0], parts[1]
+	allowed, denied := false, false
+	for _, x := range p.AllowedOwners {
+		allowed = allowed || strings.EqualFold(x, owner)
+	}
+	for _, x := range p.DeniedOwners {
+		denied = denied || strings.EqualFold(x, owner)
+	}
+	for _, x := range p.AllowedActions {
+		allowed = allowed || strings.EqualFold(x, owner+"/"+action)
+	}
+	for _, x := range p.DeniedActions {
+		denied = denied || strings.EqualFold(x, owner+"/"+action)
+	}
+	if allowed && !denied {
+		return
+	}
+	if ContainsExpression(ref) {
+		r.Errorf(s.Pos, "%s %q uses a ref that is a dynamic expression and cannot be verified for pinning", kind(workflow), v)
+		return
+	}
+	patterns := map[string]*regexp.Regexp{"major-minor": regexp.MustCompile(`^v[0-9]+\.[0-9]+$`), "semver": regexp.MustCompile(`^v[0-9]+\.[0-9]+\.[0-9]+(?:-[0-9A-Za-z.-]+)?$`), "commit-sha": regexp.MustCompile(`^[0-9a-f]{40}$`)}
+	valid := patterns[p.Level].MatchString(ref)
+	if p.Level == "major-minor" {
+		valid = valid || patterns["semver"].MatchString(ref) || patterns["commit-sha"].MatchString(ref)
+	}
+	if valid {
+		return
+	}
+	msg := fmt.Sprintf("%s %q is not pinned to %s", kind(workflow), v, p.Level)
+	if suggestion := knownVersion(owner+"/"+action, p.Level); suggestion != "" {
+		msg += "; use " + suggestion
+	}
+	r.Error(s.Pos, msg)
+}
+func kind(workflow bool) string {
+	if workflow {
+		return "reusable workflow"
+	}
+	return "action"
+}
+func knownVersion(name, level string) string {
+	var refs []string
+	for spec := range PopularActions {
+		i := strings.IndexByte(spec, '@')
+		if i > 0 && strings.EqualFold(spec[:i], name) {
+			refs = append(refs, spec[i+1:])
+		}
+	}
+	sort.Strings(refs)
+	if len(refs) == 0 {
+		return ""
+	}
+	return name + "@" + refs[len(refs)-1]
+}
+func (r *RuleActionPinning) VisitStep(n *Step) error {
+	if e, ok := n.Exec.(*ExecAction); ok {
+		r.check(e.Uses, false)
+	}
+	return nil
+}
+func (r *RuleActionPinning) VisitJobPre(n *Job) error {
+	if n.WorkflowCall != nil {
+		r.check(n.WorkflowCall.Uses, true)
+	}
+	return nil
+}
