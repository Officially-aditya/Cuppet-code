@@ -0,0 +1,219 @@
+package actionlint
+
+import (
+	"io"
+	"strings"
+	"testing"
+)
+
+func runActionPinningRule(t *testing.T, source, path string, cfg *Config, override ActionPinningLevel) []*Error {
+	t.Helper()
+	workflow, parseErrs := Parse([]byte(source))
+	if workflow == nil || len(parseErrs) != 0 {
+		t.Fatalf("could not parse test workflow: %v", parseErrs)
+	}
+	rule := NewRuleActionPinning(path, override)
+	rule.SetConfig(cfg)
+	visitor := NewVisitor()
+	visitor.AddPass(rule)
+	if err := visitor.Visit(workflow); err != nil {
+		t.Fatal(err)
+	}
+	return rule.Errs()
+}
+
+func TestActionPinningRefSatisfies(t *testing.T) {
+	sha := strings.Repeat("a", 40)
+	tests := []struct {
+		ref   string
+		level ActionPinningLevel
+		want  bool
+	}{
+		{"v1.2", ActionPinningLevelMajorMinor, true},
+		{"v1.2.3", ActionPinningLevelMajorMinor, true},
+		{"v1.2.3-rc.1", ActionPinningLevelMajorMinor, true},
+		{sha, ActionPinningLevelMajorMinor, true},
+		{"v1", ActionPinningLevelMajorMinor, false},
+		{"v1.2", ActionPinningLevelSemver, false},
+		{"v1.2.3", ActionPinningLevelSemver, true},
+		{"v1.2.3-alpha.1+build.2", ActionPinningLevelSemver, true},
+		{"v01.2.3", ActionPinningLevelSemver, false},
+		{sha, ActionPinningLevelSemver, true},
+		{"v1.2.3", ActionPinningLevelCommitSHA, false},
+		{sha, ActionPinningLevelCommitSHA, true},
+		{strings.Repeat("A", 40), ActionPinningLevelCommitSHA, false},
+	}
+	for _, tc := range tests {
+		t.Run(string(tc.level)+"_"+tc.ref, func(t *testing.T) {
+			if got := actionPinningRefSatisfies(tc.ref, tc.level); got != tc.want {
+				t.Fatalf("actionPinningRefSatisfies(%q, %q) = %v, want %v", tc.ref, tc.level, got, tc.want)
+			}
+		})
+	}
+}
+
+func TestRuleActionPinningUsesFirstAtAsSeparator(t *testing.T) {
+	source := `
+on: push
+jobs:
+  test:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: owner/action@${{ inputs.ref }}@suffix
+`
+	cfg := &Config{ActionPinning: &ActionPinningConfig{}}
+	errs := runActionPinningRule(t, source, "test.yml", cfg, "")
+	if len(errs) != 1 || !strings.Contains(errs[0].Message, "dynamic expression that cannot be verified for pinning") {
+		t.Fatalf("unexpected errors: %v", errs)
+	}
+}
+
+func TestRuleActionPinningIgnoresAtInsideActionExpression(t *testing.T) {
+	source := `
+on: push
+jobs:
+  test:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: ${{ format('{0}@{1}', matrix.owner, matrix.action) }}@main
+`
+	cfg := &Config{ActionPinning: &ActionPinningConfig{}}
+	if errs := runActionPinningRule(t, source, "test.yml", cfg, ""); len(errs) != 0 {
+		t.Fatalf("dynamic action name must be skipped: %v", errs)
+	}
+}
+
+func TestRuleActionPinningChecksActionsAndReusableWorkflows(t *testing.T) {
+	sha := strings.Repeat("a", 40)
+	source := `
+on: push
+jobs:
+  call-bad:
+    uses: owner/repo/.github/workflows/test.yml@main
+  call-good:
+    uses: owner/repo/.github/workflows/test.yml@v1.2.3-rc.1
+  test:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: owner/action@v1.2
+      - uses: owner/action@v1.2.3
+      - uses: owner/action@` + sha + `
+      - uses: ./local
+      - uses: docker://alpine:latest
+      - uses: ${{ matrix.action }}@main
+      - uses: owner/action@${{ inputs.ref }}
+`
+	cfg := &Config{ActionPinning: &ActionPinningConfig{}}
+	errs := runActionPinningRule(t, source, ".github/workflows/test.yml", cfg, "")
+	if len(errs) != 3 {
+		t.Fatalf("got %d errors, want 3: %v", len(errs), errs)
+	}
+	messages := ""
+	for _, err := range errs {
+		if err.Kind != "action-pinning" {
+			t.Fatalf("unexpected error kind: %v", err)
+		}
+		messages += err.Message + "\n"
+	}
+	for _, want := range []string{"reusable workflow reference", "action reference", "semver", "dynamic expression that cannot be verified for pinning"} {
+		if !strings.Contains(messages, want) {
+			t.Fatalf("messages do not contain %q: %s", want, messages)
+		}
+	}
+}
+
+func TestRuleActionPinningAllowAndDeny(t *testing.T) {
+	source := `
+on: push
+jobs:
+  test:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: Trusted/good@main
+      - uses: trusted/blocked@main
+      - uses: Path/action/subdir@main
+`
+	cfg, err := ParseConfig([]byte(`
+action-pinning:
+  allowed-owners: [TRUSTED]
+  denied-actions: [trusted/blocked]
+paths:
+  '.github/workflows/**':
+    action-pinning:
+      allowed-actions: [path/action]
+`))
+	if err != nil {
+		t.Fatal(err)
+	}
+	errs := runActionPinningRule(t, source, ".github/workflows/test.yml", cfg, "")
+	if len(errs) != 1 || !strings.Contains(errs[0].Message, "trusted/blocked@main") {
+		t.Fatalf("unexpected errors: %v", errs)
+	}
+}
+
+func TestRuleActionPinningPathAndCLILevels(t *testing.T) {
+	source := `
+on: push
+jobs:
+  test:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: owner/action@v1.2
+`
+	cfg, err := ParseConfig([]byte(`
+action-pinning:
+  level: commit-sha
+paths:
+  '.github/workflows/**':
+    action-pinning:
+      level: major-minor
+`))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if errs := runActionPinningRule(t, source, ".github/workflows/test.yml", cfg, ""); len(errs) != 0 {
+		t.Fatalf("path override should permit v1.2: %v", errs)
+	}
+	if errs := runActionPinningRule(t, source, ".github/workflows/test.yml", cfg, ActionPinningLevelCommitSHA); len(errs) != 1 {
+		t.Fatalf("CLI override should require SHA: %v", errs)
+	}
+}
+
+func TestRuleActionPinningKnownActionSuggestion(t *testing.T) {
+	source := `
+on: push
+jobs:
+  test:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@main
+`
+	cfg := &Config{ActionPinning: &ActionPinningConfig{}}
+	errs := runActionPinningRule(t, source, "test.yml", cfg, "")
+	if len(errs) != 1 || !strings.Contains(errs[0].Message, `known version "actions/checkout@v`) {
+		t.Fatalf("known action version was not suggested: %v", errs)
+	}
+}
+
+func TestLinterActionPinningCLIOverride(t *testing.T) {
+	linter, err := NewLinter(io.Discard, &LinterOptions{ActionPinningLevel: "major-minor"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	errs, err := linter.LintStdin(strings.NewReader("on: push\njobs:\n  test:\n    runs-on: ubuntu-latest\n    steps:\n      - uses: owner/action@main\n"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	found := false
+	for _, err := range errs {
+		if err.Kind == "action-pinning" {
+			found = true
+		}
+	}
+	if !found {
+		t.Fatalf("CLI override did not enable action-pinning: %v", errs)
+	}
+	if _, err := NewLinter(io.Discard, &LinterOptions{ActionPinningLevel: "loose"}); err == nil {
+		t.Fatal("invalid CLI action pinning level was accepted")
+	}
+}
