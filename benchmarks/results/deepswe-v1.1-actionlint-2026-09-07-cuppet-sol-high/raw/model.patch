new file mode 100644
index 0000000..fb6b3d3
--- /dev/null
+++ b/rule_action_pinning_test.go
@@ -0,0 +1,171 @@
+package actionlint
+
+import (
+	"strings"
+	"testing"
+)
+
+const fullCommitSHA = "0123456789abcdef0123456789abcdef01234567"
+
+func runActionPinningRule(t *testing.T, config *ActionPinningConfig, actionUses, workflowUses []string) []*Error {
+	t.Helper()
+	rule := NewRuleActionPinning(config)
+	for _, uses := range actionUses {
+		if err := rule.VisitStep(&Step{Exec: &ExecAction{Uses: &String{Value: uses, Pos: &Pos{Line: 1, Col: 1}}}}); err != nil {
+			t.Fatal(err)
+		}
+	}
+	for _, uses := range workflowUses {
+		job := &Job{WorkflowCall: &WorkflowCall{Uses: &String{Value: uses, Pos: &Pos{Line: 2, Col: 1}}}}
+		if err := rule.VisitJobPre(job); err != nil {
+			t.Fatal(err)
+		}
+	}
+	return rule.Errs()
+}
+
+func TestRuleActionPinningLevels(t *testing.T) {
+	tests := []struct {
+		level ActionPinningLevel
+		ref   string
+		want  bool
+	}{
+		{ActionPinningLevelMajorMinor, "v1.2", true},
+		{ActionPinningLevelMajorMinor, "v1.2.3", true},
+		{ActionPinningLevelMajorMinor, "v1.2.3-rc.1", true},
+		{ActionPinningLevelMajorMinor, fullCommitSHA, true},
+		{ActionPinningLevelMajorMinor, "v1", false},
+		{ActionPinningLevelSemver, "v1.2", false},
+		{ActionPinningLevelSemver, "v1.2.3", true},
+		{ActionPinningLevelSemver, "v1.2.3-beta.2+build.4", true},
+		{ActionPinningLevelSemver, "v1.2.3-01", false},
+		{ActionPinningLevelSemver, fullCommitSHA, true},
+		{ActionPinningLevelSemver, "main", false},
+		{ActionPinningLevelCommitSHA, "v1.2.3", false},
+		{ActionPinningLevelCommitSHA, fullCommitSHA, true},
+		{ActionPinningLevelCommitSHA, strings.ToUpper(fullCommitSHA), false},
+		{ActionPinningLevelCommitSHA, fullCommitSHA[:39], false},
+	}
+	for _, tc := range tests {
+		t.Run(string(tc.level)+"/"+tc.ref, func(t *testing.T) {
+			errs := runActionPinningRule(t, &ActionPinningConfig{Level: tc.level}, []string{"owner/repo@" + tc.ref}, nil)
+			if have := len(errs) == 0; have != tc.want {
+				t.Fatalf("ref acceptance was %v, wanted %v; errors: %v", have, tc.want, errs)
+			}
+			if len(errs) > 0 && errs[0].Kind != "action-pinning" {
+				t.Fatalf("unexpected error kind %q", errs[0].Kind)
+			}
+		})
+	}
+}
+
+func TestRuleActionPinningReferenceKinds(t *testing.T) {
+	errs := runActionPinningRule(t, &ActionPinningConfig{Level: ActionPinningLevelSemver},
+		[]string{"owner/action@main"}, []string{"owner/repo/.github/workflows/ci.yml@main"})
+	if len(errs) != 2 {
+		t.Fatalf("wanted two errors but got %d: %v", len(errs), errs)
+	}
+	if !strings.Contains(errs[0].Message, "step action reference") {
+		t.Errorf("step action error was not distinguished: %q", errs[0].Message)
+	}
+	if !strings.Contains(errs[1].Message, "reusable workflow reference") {
+		t.Errorf("reusable workflow error was not distinguished: %q", errs[1].Message)
+	}
+}
+
+func TestRuleActionPinningSkipsSpecialReferences(t *testing.T) {
+	actions := []string{
+		"./local/action",
+		"docker://alpine:latest",
+		"${{ matrix.action }}@main",
+		"owner/${{ matrix.action }}@main",
+	}
+	workflows := []string{"./.github/workflows/local.yml", "${{ inputs.workflow }}@main"}
+	if errs := runActionPinningRule(t, &ActionPinningConfig{Level: ActionPinningLevelCommitSHA}, actions, workflows); len(errs) != 0 {
+		t.Fatalf("special references must be skipped: %v", errs)
+	}
+}
+
+func TestRuleActionPinningDynamicRef(t *testing.T) {
+	errs := runActionPinningRule(t, &ActionPinningConfig{Level: ActionPinningLevelSemver},
+		[]string{"owner/action@${{ matrix.ref }}"}, []string{"owner/repo/.github/workflows/ci.yml@${{ inputs.ref }}"})
+	if len(errs) != 2 {
+		t.Fatalf("wanted two errors but got %d: %v", len(errs), errs)
+	}
+	for _, err := range errs {
+		if !strings.Contains(err.Message, "dynamic expression") || !strings.Contains(err.Message, "cannot be verified for pinning") {
+			t.Errorf("unexpected dynamic ref error: %q", err.Message)
+		}
+	}
+}
+
+func TestRuleActionPinningExpressionContainingAtSign(t *testing.T) {
+	actions := []string{
+		"${{ format('{0}@{1}', inputs.owner, inputs.action) }}@main",
+		"owner/${{ format('{0}@suffix', inputs.action) }}@main",
+	}
+	if errs := runActionPinningRule(t, &ActionPinningConfig{Level: ActionPinningLevelSemver}, actions, nil); len(errs) != 0 {
+		t.Fatalf("dynamic action names must be skipped: %v", errs)
+	}
+
+	errs := runActionPinningRule(t, &ActionPinningConfig{Level: ActionPinningLevelSemver}, []string{"owner/action@${{ format('{0}@suffix', inputs.ref) }}"}, nil)
+	if len(errs) != 1 || !strings.Contains(errs[0].Message, "dynamic expression") {
+		t.Fatalf("dynamic ref containing @ was not detected: %v", errs)
+	}
+}
+
+func TestRuleActionPinningAllowAndDenyLists(t *testing.T) {
+	config := &ActionPinningConfig{
+		Level:          ActionPinningLevelSemver,
+		AllowedOwners:  []string{"AllowedOwner", "ConflictOwner"},
+		AllowedActions: []string{"other/allowed"},
+		DeniedOwners:   []string{"conflictowner"},
+		DeniedActions:  []string{"allowedowner/denied"},
+	}
+	actions := []string{
+		"allowedowner/free@main",
+		"OTHER/ALLOWED@main",
+		"AllowedOwner/Denied@main",
+		"ConflictOwner/repo@main",
+		"unlisted/repo@main",
+	}
+	errs := runActionPinningRule(t, config, actions, nil)
+	if len(errs) != 3 {
+		t.Fatalf("wanted denied and unlisted actions to be checked, got %d errors: %v", len(errs), errs)
+	}
+	for _, want := range []string{"AllowedOwner/Denied", "ConflictOwner/repo", "unlisted/repo"} {
+		found := false
+		for _, err := range errs {
+			found = found || strings.Contains(err.Message, want)
+		}
+		if !found {
+			t.Errorf("no pinning error found for %q: %v", want, errs)
+		}
+	}
+}
+
+func TestRuleActionPinningAllowedDynamicRefs(t *testing.T) {
+	config := &ActionPinningConfig{
+		Level:          ActionPinningLevelSemver,
+		AllowedActions: []string{"owner/allowed", "owner/conflict"},
+		DeniedActions:  []string{"OWNER/CONFLICT"},
+	}
+	errs := runActionPinningRule(t, config, []string{
+		"owner/allowed@${{ inputs.ref }}",
+		"owner/conflict@${{ inputs.ref }}",
+		"owner/checked@${{ inputs.ref }}",
+	}, nil)
+	if len(errs) != 2 {
+		t.Fatalf("wanted conflicted and unlisted dynamic refs to be checked: %v", errs)
+	}
+}
+
+func TestRuleActionPinningPopularActionSuggestion(t *testing.T) {
+	errs := runActionPinningRule(t, &ActionPinningConfig{Level: ActionPinningLevelSemver}, []string{"actions/checkout@v4"}, nil)
+	if len(errs) != 1 {
+		t.Fatalf("wanted one error but got %d: %v", len(errs), errs)
+	}
+	if !strings.Contains(errs[0].Message, `known action version "actions/checkout@v4"`) {
+		t.Fatalf("popular action error did not contain its known version: %q", errs[0].Message)
+	}
+}
