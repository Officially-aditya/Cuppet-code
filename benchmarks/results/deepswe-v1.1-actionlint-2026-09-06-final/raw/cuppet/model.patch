diff --git a/rule_action_pinning.go b/rule_action_pinning.go
new file mode 100644
index 0000000..104158e
--- /dev/null
+++ b/rule_action_pinning.go
@@ -0,0 +1,148 @@
+package actionlint
+
+import (
+	"fmt"
+	"regexp"
+	"sort"
+	"strings"
+)
+
+type RuleActionPinning struct {
+	RuleBase
+	path, level string
+	cli         bool
+}
+
+func NewRuleActionPinning(path, level string) *RuleActionPinning {
+	return &RuleActionPinning{RuleBase: NewRuleBase("action-pinning", "Checks that actions and reusable workflows use pinned versions"), path: path, level: level, cli: level != ""}
+}
+
+func (r *RuleActionPinning) VisitStep(n *Step) error {
+	e, ok := n.Exec.(*ExecAction)
+	if !ok || e.Uses == nil {
+		return nil
+	}
+	r.check(e.Uses, false)
+	return nil
+}
+func (r *RuleActionPinning) VisitJobPre(n *Job) error {
+	if n.WorkflowCall != nil && n.WorkflowCall.Uses != nil {
+		r.check(n.WorkflowCall.Uses, true)
+	}
+	return nil
+}
+
+func (r *RuleActionPinning) config() (*ActionPinningConfig, bool) {
+	if r.cli {
+		return &ActionPinningConfig{Level: r.level}, true
+	}
+	if r.RuleBase.config == nil {
+		return nil, false
+	}
+	var xs []*ActionPinningConfig
+	if r.RuleBase.config.ActionPinning != nil {
+		xs = append(xs, r.RuleBase.config.ActionPinning)
+	}
+	for _, p := range r.RuleBase.config.PathConfigs(r.path) {
+		if p.ActionPinning != nil {
+			xs = append(xs, p.ActionPinning)
+		}
+	}
+	if len(xs) == 0 {
+		return nil, false
+	}
+	c := &ActionPinningConfig{Level: "semver"}
+	for _, x := range xs {
+		if x.Level != "" {
+			c.Level = x.Level
+		}
+		c.AllowedOwners = append(c.AllowedOwners, x.AllowedOwners...)
+		c.AllowedActions = append(c.AllowedActions, x.AllowedActions...)
+		c.DeniedOwners = append(c.DeniedOwners, x.DeniedOwners...)
+		c.DeniedActions = append(c.DeniedActions, x.DeniedActions...)
+	}
+	return c, true
+}
+
+func (r *RuleActionPinning) check(s *String, workflow bool) {
+	c, enabled := r.config()
+	if !enabled || strings.HasPrefix(s.Value, "./") || strings.HasPrefix(s.Value, "docker://") {
+		return
+	}
+	i := strings.LastIndexByte(s.Value, '@')
+	if i < 0 {
+		return
+	}
+	name, ref := s.Value[:i], s.Value[i+1:]
+	if ContainsExpression(name) {
+		return
+	}
+	parts := strings.Split(name, "/")
+	owner := parts[0]
+	repo := ""
+	if len(parts) > 1 {
+		repo = parts[1]
+	}
+	key := strings.ToLower(owner + "/" + repo)
+	allowed := false
+	denied := false
+	for _, v := range c.AllowedOwners {
+		allowed = allowed || strings.EqualFold(v, owner)
+	}
+	for _, v := range c.DeniedOwners {
+		denied = denied || strings.EqualFold(v, owner)
+	}
+	for _, v := range c.AllowedActions {
+		allowed = allowed || strings.EqualFold(v, key)
+	}
+	for _, v := range c.DeniedActions {
+		denied = denied || strings.EqualFold(v, key)
+	}
+	if allowed && !denied {
+		return
+	}
+	if ContainsExpression(ref) {
+		r.Errorf(s.Pos, "%s %q uses a ref that is a dynamic expression and cannot be verified for pinning", kind(workflow), s.Value)
+		return
+	}
+	ok := false
+	switch c.Level {
+	case "major-minor":
+		ok = regexp.MustCompile(`^v[0-9]+\.[0-9]+$`).MatchString(ref)
+	case "commit-sha":
+		ok = regexp.MustCompile(`^[0-9a-f]{40}$`).MatchString(ref)
+	default:
+		ok = regexp.MustCompile(`^v[0-9]+\.[0-9]+\.[0-9]+(?:-[0-9A-Za-z.-]+)?$`).MatchString(ref)
+	}
+	if ok {
+		return
+	}
+	msg := fmt.Sprintf("%s %q is not pinned to a %s", kind(workflow), s.Value, c.Level)
+	if c.Level == "" {
+		msg = fmt.Sprintf("%s %q is not pinned to a semver", kind(workflow), s.Value)
+	}
+	if v := knownVersion(name); v != "" {
+		msg += fmt.Sprintf("; use %s", v)
+	}
+	r.Error(s.Pos, msg)
+}
+func kind(w bool) string {
+	if w {
+		return "reusable workflow"
+	}
+	return "action"
+}
+func knownVersion(name string) string {
+	var vs []string
+	prefix := name + "@"
+	for k := range PopularActions {
+		if strings.HasPrefix(k, prefix) {
+			vs = append(vs, strings.TrimPrefix(k, prefix))
+		}
+	}
+	sort.Strings(vs)
+	if len(vs) > 0 {
+		return vs[len(vs)-1]
+	}
+	return ""
+}
