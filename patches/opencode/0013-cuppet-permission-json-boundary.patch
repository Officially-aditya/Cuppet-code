+/**
+ * Permission metadata crosses both SSE and HTTP schema boundaries. Tool
+ * metadata commonly contains optional properties with `undefined` values,
+ * which are valid in process but are not JSON values and can prevent the
+ * permission dialog from ever reaching the TUI. Normalize once before a
+ * request enters the pending map so every delivery and recovery path sees the
+ * same serializable payload.
+ */
+function jsonSafeMetadata(metadata: Record<string, unknown>): Record<string, unknown> {
+  try {
+    const encoded = JSON.stringify(metadata)
+    if (!encoded) return {}
+    const decoded = JSON.parse(encoded) as unknown
+    return decoded && typeof decoded === "object" && !Array.isArray(decoded)
+      ? (decoded as Record<string, unknown>)
+      : {}
+  } catch {
+    return Object.fromEntries(
+      Object.entries(metadata).filter(([, value]) =>
+        value === null || ["string", "number", "boolean"].includes(typeof value),
+      ),
+    )
+  }
+}
+
 function expand(pattern: string): string {
