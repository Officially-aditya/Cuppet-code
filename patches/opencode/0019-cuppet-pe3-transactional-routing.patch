+export async function commitCuppetNativeRoute(routeToken: string): Promise<void> {
+  await finishCuppetNativeRoute("pe3.commit-native-route", routeToken, "committed")
+}
+
+export async function abortCuppetNativeRoute(routeToken: string): Promise<void> {
+  await finishCuppetNativeRoute("pe3.abort-native-route", routeToken, "aborted")
+}
+
+async function finishCuppetNativeRoute(
+  method: "pe3.commit-native-route" | "pe3.abort-native-route",
+  routeToken: string,
+  acknowledgement: "committed" | "aborted",
+): Promise<void> {
+  const socketPath = process.env.CUPPET_CONTROL_SOCKET
+  const token = process.env.CUPPET_CONTROL_TOKEN
+  if (!socketPath || !token) throw new Error("PE3 control channel is unavailable")
+  const result = await callControl(socketPath, {
+    token,
+    method,
+    params: { routeToken },
+  })
+  if (
+    !result ||
+    typeof result !== "object" ||
+    Array.isArray(result) ||
+    (result as Record<string, unknown>)[acknowledgement] !== true
+  ) {
+    throw new Error(`PE3 native route ${acknowledgement} acknowledgement missing`)
+  }
 }
 
