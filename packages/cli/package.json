{
  "name": "cuppet",
  "version": "0.2.0-alpha.2",
  "description": "Cuppet-branded OpenCode derivative with native tiered memory",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "cuppet": "dist/cli.js",
    "cupet": "dist/cli.js"
  },
  "files": [
    "dist",
    "relay-app",
    "README.md",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsup",
    "start": "node dist/cli.js",
    "start:relay": "node dist/cli.js relay --bind 0.0.0.0",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "dev": "tsx src/cli.tsx",
    "prepack": "node ../../scripts/prepare-cli-package.mjs && npm run build",
    "postpack": "node ../../scripts/cleanup-cli-package.mjs",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opencode-ai/sdk": "1.18.4",
    "qrcode": "1.5.4",
    "zod": "3.25.76"
  },
  "optionalDependencies": {
    "@cuppet-code/runtime-darwin-arm64": "0.2.0-alpha.2",
    "@cuppet-code/runtime-darwin-x64": "0.2.0-alpha.2",
    "@cuppet-code/runtime-linux-arm64-gnu": "0.2.0-alpha.2",
    "@cuppet-code/runtime-linux-x64-gnu": "0.2.0-alpha.2"
  },
  "devDependencies": {
    "@types/qrcode": "1.5.6",
    "tsup": "8.4.0"
  }
}
